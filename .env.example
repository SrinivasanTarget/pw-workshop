# Copy to `.env` and adjust if needed.

# App under test. Defaults to the deployed workshop app when unset.
# Override to point at a local build, e.g. http://localhost:5173
BASE_URL=https://playwright-workshop.pages.dev

# NOTE: The Claude Code VS Code extension reads your Anthropic API key from the
# extension itself (Command Palette -> "Claude Code: Sign In", or an
# ANTHROPIC_API_KEY set in your shell/VS Code env). It is NOT loaded from this
# file. This line is only a reminder of what you need configured.
# ANTHROPIC_API_KEY=sk-ant-...
